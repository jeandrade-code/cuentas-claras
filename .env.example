APP_NAME="Cuentas Claras"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================================
# BASE DE DATOS — alterna comentando/descomentando
# ============================================================================

# ─── Opción 1: SQLite (desarrollo local) ─────────────────────────────────────
DB_CONNECTION=sqlite
# DB_DATABASE=                                    # vacío = usa database/database.sqlite
# DB_FOREIGN_KEYS=true

# ─── Opción 2: MySQL (pruebas locales / producción) ─────────────────────────
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cuentas_claras
# DB_USERNAME=cuentas_claras
# DB_PASSWORD=tu_password_segura
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==============================================================================
# CONFIGURACIÓN DE CORREO (GMAIL)
# ==============================================================================

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

# IMPORTANTE: Aquí va tu correo completo de Gmail (ej: juan@gmail.com).
MAIL_USERNAME=tu_correo@gmail.com

# CRÍTICO: Aquí NO va tu contraseña normal de Gmail.
# Debes generar una "Contraseña de Aplicación" de 16 caracteres.
# https://myaccount.google.com/apppasswords   -> Tiene que estar activada la verificación en dos pasos para poder generar esta contraseña.
MAIL_PASSWORD=abcdefghijklmnop

MAIL_ENCRYPTION=tls

# Este correo DEBE ser exactamente igual a MAIL_USERNAME.
# Si pones uno distinto, Gmail rechazará el correo o lo enviará como SPAM.
MAIL_FROM_ADDRESS="tu_correo@gmail.com"

# Este es el nombre que verá el destinatario en su bandeja de entrada.
MAIL_FROM_NAME="Cuentas Claras"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AUTH_PASSWORD_RESET_EXPIRE=30

# --- Legal ---
LEGAL_APP_NAME="Cuentas Claras"
LEGAL_COMPANY_NAME=
LEGAL_COMPANY_NIT=
LEGAL_COMPANY_DOMICILE=
LEGAL_COMPANY_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_DPO_NAME=
LEGAL_DPO_EMAIL=
LEGAL_POLICY_VERSION=1.0.0
LEGAL_POLICY_DATE=
LEGAL_TERMS_VERSION=1.0.0
LEGAL_TERMS_DATE=
LEGAL_MIN_AGE=18
LEGAL_RETENTION_ACTIVE=365
LEGAL_RETENTION_CLOSED=1095
LEGAL_RETENTION_AUDIT=1825
LEGAL_INCIDENT_HOURS=72